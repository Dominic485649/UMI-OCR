#include <windows.h>

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Umi-OCR CUDA worker"
            VALUE "FileVersion", "@UMIOCR_VERSION@.0"
            VALUE "InternalName", "UmiOCR-CudaWorker"
            VALUE "OriginalFilename", "UmiOCR-CudaWorker.exe"
            VALUE "ProductName", "Umi-OCR GPU OCR plugin"
            VALUE "ProductVersion", "@UMIOCR_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
