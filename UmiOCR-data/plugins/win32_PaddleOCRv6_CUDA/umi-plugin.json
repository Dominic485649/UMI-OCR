{
  "schema_version": 1,
  "id": "win32_PaddleOCRv6_CUDA",
  "name": "PP-OCRv6 CUDA",
  "version": "3.1.2",
  "host_api": ">=2.10,<3.0",
  "platform": [
    "win32"
  ],
  "arch": [
    "x86_64"
  ],
  "vendor": "Umi-OCR",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/Dominic485649/UMI-OCR_plugins",
  "description": "基于独立 worker 运行的 PaddlePaddle GPU PP-OCRv6 文字识别后端。普通档使用 CUDA 12.6，RTX 50 档使用 CUDA 12.9；同一插件择一安装，不提供 CPU 回退。",
  "conflicts": [],
  "capabilities": [
    {
      "type": "ocr",
      "entry": "api:Api",
      "config": "config:CONFIG",
      "meta": {
        "settingsOrder": 10
      }
    }
  ],
  "health": "health:check",
  "i18n": "i18n.csv",
  "runtime": {
    "priority": "append",
    "vendor_dirs": [],
    "dll_dirs": [],
    "closure_lock": "runtime.lock.json",
    "process_boundary": {
      "type": "separate-worker-stdio-ipc",
      "entry": "UmiOCR-CudaWorker.exe",
      "request_schema": "JSON lines: run_path(path) or run_bytes(base64)",
      "response_schema": "JSON lines: OCR result {code,data} and timing"
    }
  }
}
